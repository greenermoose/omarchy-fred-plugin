#!/usr/bin/env bash
# tam-plugin — Discover, install, and manage Fred's Omarchy shell plugins (fred.*)
#
# Part of the Omarchy Fred Plugin Suite (https://github.com/greenermoose/plugin-fred-tamlinux)
# License: GPL-3.0-or-later

set -euo pipefail

VERSION="1.1.1"

# Directories
LIVE_DIR="${FRED_LIVE_DIR:-${HOME}/.config/omarchy/plugins}"
CACHE_DIR="${HOME}/.cache/tam-plugin"
TEST_ROOT="${FRED_TEST_ROOT:-${XDG_STATE_HOME:-${HOME}/.local/state}/tam-plugin/test}"
PUBLISHED_ROOT="${FRED_PUBLISHED_ROOT:-${HOME}/Code/tamlinux}"
MARKETPLACE_REGISTRY_URL="https://raw.githubusercontent.com/omacom/omarchy-plugin-marketplace/main/registry.json"

# Auto-detect local development config repository if present
REPO_DIR="${FRED_CONFIG_REPO:-${HOME}/Code/tamlinux/config-fred-tamlinux}"
PLUGINS_SRC="${REPO_DIR}/config/omarchy/plugins"

# Known Fred plugins catalog
declare -A CATALOG_REPOS=(
  ["fred.workspaces"]="https://github.com/greenermoose/workspaces-fred-tamlinux.git"
  ["fred.clock"]="https://github.com/greenermoose/clock-fred-tamlinux.git"
  ["fred.sysinfo"]="https://github.com/greenermoose/sysinfo-fred-tamlinux.git"
  ["fred.monitor"]="https://github.com/greenermoose/monitor-fred-tamlinux.git"
  ["fred.weather"]="https://github.com/greenermoose/weather-fred-tamlinux.git"
  ["fred.tides"]="https://github.com/greenermoose/tides-fred-tamlinux.git"
  ["fred.keyboard"]="https://github.com/greenermoose/keyboard-fred-tamlinux.git"
  ["fred.agents"]="https://github.com/greenermoose/agents-fred-tamlinux.git"
)

declare -A CATALOG_DESC=(
  ["fred.workspaces"]="Dynamic workspace indicator with multi-monitor desktop mode switcher"
  ["fred.clock"]="Next-event countdown badge, multi-feed iCal sync, and interactive agenda"
  ["fred.sysinfo"]="Universal hardware telemetry and system monitoring bar plugin"
  ["fred.monitor"]="Display management panel with per-display link Reset and arrangement"
  ["fred.weather"]="10-day outlook, 48-hour curve, and solar timeline with multi-monitor isolation"
  ["fred.tides"]="Multi-monitor tide widget with current sea level, 24-hour scrubbable curve, and high/low timeline"
  ["fred.keyboard"]="Keyboard shortcut explorer: see which keys run which commands on a model of your keyboard"
  ["fred.agents"]="AI agent usage bar plugin: Antigravity, Claude, Codex, and Cursor prompt/token activity at a glance"
)

# Catalog entries whose public repository does not exist yet. They are listed so
# the suite is discoverable, but they cannot be installed or updated.
declare -A CATALOG_UNPUBLISHED=()

published_dir() {
  local id="$1"
  printf '%s/%s-fred-tamlinux\n' "$PUBLISHED_ROOT" "${id#fred.}"
}

fail() {
  echo "tam-plugin: $*" >&2
  exit 1
}

warn() {
  echo "tam-plugin: warning: $*" >&2
}

# Two caches stand between a deployed plugin file and the running bar:
#  - in memory: Quickshell 0.3.1 exposes no Qt.clearComponentCache, so the
#    shell's plugin rescan only refreshes manifest metadata and
#    Qt.createComponent keeps returning the code loaded at shell start;
#  - on disk: Qt validates ~/.cache/quickshell/qmlcache/<sha1(path)>.qmlc by
#    source mtime alone, and Nix store files all carry mtime 1970, so a
#    redeploy at the same path is served from the stale compile even after a
#    restart.
# Purge the disk entries for the local plugins, then restart the shell.
purge_qmlcache() {
  local plugins_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/quickshell/qmlcache"
  [[ -d "$plugins_dir" && -d "$cache_dir" ]] || return 0
  local src hash
  while IFS= read -r -d '' src; do
    hash=$(printf '%s' "$src" | sha1sum | cut -d' ' -f1)
    rm -f -- "$cache_dir/$hash.qmlc" "$cache_dir/$hash.jsc"
  done < <(find -L "$plugins_dir" -type f \( -name '*.qml' -o -name '*.js' -o -name '*.mjs' \) -print0 2>/dev/null)
}

reload_shell() {
  command -v omarchy-shell >/dev/null 2>&1 || return 0
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  purge_qmlcache
  if command -v omarchy-restart-shell >/dev/null 2>&1; then
    echo "restarting shell: plugin QML is cached (memory and ~/.cache/quickshell/qmlcache) until restart"
    omarchy-restart-shell || warn "shell restart failed (locked session?); run 'omarchy-restart-shell' to load the new plugin code"
  else
    warn "omarchy-restart-shell not found; restart the shell to load the new plugin code"
  fi
}

usage() {
  cat <<USAGE
tam-plugin v${VERSION} — Discover, install, and manage Fred's Omarchy shell plugins

Usage:
  tam-plugin list [--all] [--refresh]
  tam-plugin info <id>
  tam-plugin install <id> [--enable]
  tam-plugin update <id|all>
  tam-plugin remove <id>
  tam-plugin search [query]
  tam-plugin diff <id>
  tam-plugin dev <id> on|off
  tam-plugin test <id> [worktree|<git-ref>|undo|off|status]
  tam-plugin upstream-diff
  tam-plugin --version
  tam-plugin --help

Subcommands:
  list              Show status of installed plugins (or all catalog plugins with --all)
  info <id>         Inspect detailed plugin information, repository, and marketplace status
  install <id>      Install a fred.* plugin via omarchy plugin add (--enable to activate)
  update <id|all>   Update an installed plugin to its latest GitHub release
  remove <id>       Remove an installed plugin via omarchy plugin remove
  search [query]    Search available plugins in Fred's catalog
  diff <id>         [Developer] Diff deployed plugin against local published repo
  dev <id> on|off   [Developer] Toggle fast QML symlink override to config-fred-tamlinux
  test <id> [...]   [Developer] Test immutable snapshots from the published repo
  upstream-diff     [Developer] Compare clonedFrom stamps against installed Omarchy
USAGE
}

cmd_upstream_diff() {
  local installed_ver recorded_ver plugin_id upstream
  installed_ver=$(omarchy version 2>/dev/null || cat /usr/share/omarchy/version 2>/dev/null || echo "unknown")
  for upstream in "$PLUGINS_SRC"/fred.*/UPSTREAM.md; do
    [[ -f "$upstream" ]] || continue
    plugin_id=$(basename "$(dirname "$upstream")")
    recorded_ver=$(grep -i "Upstream Version:" "$upstream" | head -n 1 | awk '{print $NF}' | tr -d '`*')
    if [[ -n "$recorded_ver" && "$recorded_ver" != "$installed_ver" ]]; then
      warn "$plugin_id was cloned from Omarchy $recorded_ver, but installed Omarchy is $installed_ver"
    fi
  done
}

validate_plugin_id() {
  local id="$1"
  [[ "$id" =~ ^fred\.[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
    fail "invalid plugin id '$id' (expected fred.<name>)"
}

test_state_dir() {
  printf '%s/%s\n' "$TEST_ROOT" "$1"
}

test_link_target() {
  local link="$1"
  [[ -L "$link" ]] || return 1
  readlink -f -- "$link"
}

is_test_snapshot() {
  local id="$1"
  local path="$2"
  local snapshots
  snapshots="$(test_state_dir "$id")/snapshots"
  [[ "$path" == "$snapshots"/* ]]
}

set_state_link() {
  local link="$1"
  local target="$2"
  local tmp="${link}.tmp.$$"
  rm -f -- "$tmp"
  ln -s -- "$target" "$tmp"
  mv -Tf -- "$tmp" "$link"
}

switch_live_to_snapshot() {
  local id="$1"
  local snapshot="$2"
  local live="$LIVE_DIR/$id"
  local tmp="$LIVE_DIR/.${id}.test.$$"

  if [[ -e "$live" && ! -L "$live" ]]; then
    fail "test state is inconsistent: $live is not the expected test symlink"
  fi
  if [[ -L "$live" ]]; then
    local current
    current="$(readlink -f -- "$live")"
    is_test_snapshot "$id" "$current" ||
      fail "refusing to replace non-test symlink $live -> $(readlink "$live")"
  fi

  rm -f -- "$tmp"
  ln -s -- "$snapshot" "$tmp"
  mv -Tf -- "$tmp" "$live"
}

write_snapshot_metadata() {
  local metadata="$1"
  local source="$2"
  local requested_ref="$3"
  local commit="$4"
  local dirty="$5"
  {
    printf 'source: %s\n' "$source"
    printf 'requested-ref: %s\n' "$requested_ref"
    printf 'commit: %s\n' "$commit"
    printf 'working-tree-dirty: %s\n' "$dirty"
    printf 'created-at: %s\n' "$(date --iso-8601=seconds)"
  } > "$metadata"
}

create_test_snapshot() {
  local id="$1"
  local requested_ref="$2"
  local suffix="${id#fred.}"
  local source
  source="$(published_dir "$id")"
  local state snapshots stage commit dirty label snapshot manifest_id

  [[ -d "$source/.git" ]] ||
    fail "published repository not found: $source (set FRED_PUBLISHED_ROOT to customize)"
  command -v git >/dev/null 2>&1 || fail "git is required for test snapshots"
  command -v tar >/dev/null 2>&1 || fail "tar is required for test snapshots"
  command -v jq >/dev/null 2>&1 || fail "jq is required for test snapshots"

  state="$(test_state_dir "$id")"
  snapshots="$state/snapshots"
  mkdir -p -- "$snapshots"
  stage="$snapshots/.tmp.$$"
  rm -rf -- "$stage"
  mkdir -- "$stage"

  if [[ "$requested_ref" == "worktree" ]]; then
    commit="$(git -C "$source" rev-parse --short=12 HEAD 2>/dev/null || printf 'unborn')"
    if [[ -n "$(git -C "$source" status --porcelain --untracked-files=all)" ]]; then
      dirty="yes"
    else
      dirty="no"
    fi
    if ! tar --exclude='./.git' --exclude='./.git/*' -C "$source" -cf - . |
      tar -C "$stage" -xf -; then
      rm -rf -- "$stage"
      fail "could not snapshot working tree at $source"
    fi
  else
    commit="$(git -C "$source" rev-parse --verify "$requested_ref^{commit}" 2>/dev/null)" || {
      rm -rf -- "$stage"
      fail "unknown git ref '$requested_ref' in $source"
    }
    commit="${commit:0:12}"
    dirty="not-applicable"
    if ! git -C "$source" archive "$requested_ref" | tar -C "$stage" -xf -; then
      rm -rf -- "$stage"
      fail "could not snapshot git ref '$requested_ref'"
    fi
  fi

  [[ -f "$stage/manifest.json" ]] || {
    rm -rf -- "$stage"
    fail "snapshot has no manifest.json"
  }
  manifest_id="$(jq -r '.id // empty' "$stage/manifest.json")"
  [[ "$manifest_id" == "$id" ]] || {
    rm -rf -- "$stage"
    fail "snapshot manifest id '$manifest_id' does not match requested id '$id'"
  }

  if command -v omarchy >/dev/null 2>&1; then
    if ! omarchy plugin validate "$stage" >&2; then
      rm -rf -- "$stage"
      fail "plugin validation failed; the running plugin was not changed"
    fi
  elif command -v omarchy-plugin-validate >/dev/null 2>&1; then
    if ! omarchy-plugin-validate "$stage" >&2; then
      rm -rf -- "$stage"
      fail "plugin validation failed; the running plugin was not changed"
    fi
  else
    rm -rf -- "$stage"
    fail "omarchy plugin validation command not found"
  fi

  label="$(date +%Y%m%d-%H%M%S)-${commit}"
  [[ "$dirty" == "yes" ]] && label="${label}-dirty"
  snapshot="$snapshots/${label}-$$"
  mv -- "$stage" "$snapshot"
  find "$snapshot" -type d -exec chmod u+rwx,go-rwx {} +
  find "$snapshot" -type f -exec chmod a-w {} +
  write_snapshot_metadata "${snapshot}.meta" "$source" "$requested_ref" "$commit" "$dirty"
  printf '%s\n' "$snapshot"
}

enter_test_mode() {
  local id="$1"
  local state live
  state="$(test_state_dir "$id")"
  live="$LIVE_DIR/$id"

  if [[ -f "$state/active" ]]; then
    [[ -L "$live" ]] || fail "test state is inconsistent: active marker exists but $live is not a symlink"
    local target
    target="$(readlink -f -- "$live")"
    is_test_snapshot "$id" "$target" ||
      fail "test state is inconsistent: $live does not point to a managed test snapshot"
    return 0
  fi

  if [[ -L "$live" ]]; then
    fail "$live is already a symlink; leave dev mode before entering snapshot test mode"
  fi
  if [[ -e "$state/original" || -e "$state/original.absent" ]]; then
    fail "stale test recovery state exists at $state; inspect it before continuing"
  fi

  mkdir -p -- "$state" "$LIVE_DIR"
  rm -f -- "$state/current" "$state/previous"
  if [[ -e "$live" ]]; then
    mv -- "$live" "$state/original"
  else
    : > "$state/original.absent"
  fi
  : > "$state/active"
}

cmd_test_status() {
  local id="$1"
  local state live target
  state="$(test_state_dir "$id")"
  live="$LIVE_DIR/$id"

  if [[ ! -f "$state/active" ]]; then
    echo "test: mode OFF for $id"
    return 0
  fi
  [[ -L "$live" ]] || fail "test state is inconsistent: $live is not a symlink"
  target="$(readlink -f -- "$live")"
  is_test_snapshot "$id" "$target" || fail "test state is inconsistent: live target is outside $state/snapshots"
  echo "test: mode ON for $id"
  echo "snapshot: $target"
  [[ -f "${target}.meta" ]] && sed 's/^/  /' "${target}.meta"
}

cmd_test_off() {
  local id="$1"
  local state live target
  state="$(test_state_dir "$id")"
  live="$LIVE_DIR/$id"

  [[ -f "$state/active" ]] || {
    echo "test: mode is already OFF for $id"
    return 0
  }
  [[ -L "$live" ]] || fail "refusing to restore: $live is not the expected test symlink"
  target="$(readlink -f -- "$live")"
  is_test_snapshot "$id" "$target" || fail "refusing to restore: live target is outside $state/snapshots"

  if [[ -e "$state/original" ]]; then
    rm -- "$live"
    mv -- "$state/original" "$live"
  elif [[ -e "$state/original.absent" ]]; then
    rm -- "$live"
    rm -- "$state/original.absent"
  else
    fail "original live plugin state is missing from $state"
  fi
  rm -f -- "$state/active" "$state/current" "$state/previous"
  reload_shell
  echo "test: mode OFF for $id; restored the original live plugin"
}

cmd_test_undo() {
  local id="$1"
  local state current previous
  state="$(test_state_dir "$id")"
  [[ -f "$state/active" ]] || fail "$id is not in snapshot test mode"
  current="$(test_link_target "$state/current")" || fail "current test snapshot is missing"
  previous="$(test_link_target "$state/previous")" ||
    fail "no previous test snapshot; use 'tam-plugin test $id off' to restore the managed version"
  is_test_snapshot "$id" "$current" || fail "current snapshot pointer is invalid"
  is_test_snapshot "$id" "$previous" || fail "previous snapshot pointer is invalid"

  set_state_link "$state/current" "$previous"
  set_state_link "$state/previous" "$current"
  switch_live_to_snapshot "$id" "$previous"
  reload_shell
  echo "test: $id restored snapshot $previous"
}

cmd_test() {
  local id="${1:-}"
  local action="${2:-worktree}"
  [[ -n "$id" ]] || fail "test requires a plugin id (e.g. fred.agents)"
  validate_plugin_id "$id"
  umask 077

  case "$action" in
    status)
      cmd_test_status "$id"
      ;;
    off)
      cmd_test_off "$id"
      ;;
    undo)
      cmd_test_undo "$id"
      ;;
    *)
      local state snapshot old_current
      state="$(test_state_dir "$id")"
      snapshot="$(create_test_snapshot "$id" "$action")"
      enter_test_mode "$id"
      old_current="$(test_link_target "$state/current" 2>/dev/null || true)"
      if [[ -n "$old_current" ]]; then
        set_state_link "$state/previous" "$old_current"
      else
        rm -f -- "$state/previous"
      fi
      set_state_link "$state/current" "$snapshot"
      switch_live_to_snapshot "$id" "$snapshot"
      reload_shell
      echo "test: mode ON for $id -> $snapshot"
      echo "test: later edits in the source repository will not affect this snapshot"
      ;;
  esac
}

fetch_registry_json() {
  local refresh="${1:-0}"
  mkdir -p "$CACHE_DIR"
  local cached_file="$CACHE_DIR/registry.json"

  # Use cached file if newer than 3600 seconds and refresh not requested
  if [[ "$refresh" -eq 0 && -f "$cached_file" ]]; then
    local now mtime age
    now=$(date +%s)
    mtime=$(stat -c %Y "$cached_file" 2>/dev/null || stat -f %m "$cached_file" 2>/dev/null || echo 0)
    age=$(( now - mtime ))
    if (( age < 3600 )); then
      cat "$cached_file"
      return 0
    fi
  fi

  if command -v curl >/dev/null 2>&1; then
    local tmp="$cached_file.tmp.$$"
    if curl -sSL --connect-timeout 5 --max-time 10 "$MARKETPLACE_REGISTRY_URL" -o "$tmp" 2>/dev/null; then
      if [[ -s "$tmp" ]] && (command -v jq >/dev/null 2>&1 && jq empty "$tmp" 2>/dev/null); then
        mv "$tmp" "$cached_file"
        cat "$cached_file"
        return 0
      fi
      rm -f "$tmp"
    fi
  fi

  # Fallback to existing cache if offline/error
  if [[ -f "$cached_file" ]]; then
    cat "$cached_file"
  else
    echo "[]"
  fi
}

cmd_list() {
  local show_all=0
  local refresh=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all|-a) show_all=1 ;;
      --refresh|-r) refresh=1 ;;
      *) ;;
    esac
    shift
  done

  local registry_json
  registry_json="$(fetch_registry_json "$refresh")"

  # Collect plugin IDs
  local plugin_ids=()
  if [[ -d "$LIVE_DIR" ]]; then
    for dir in "$LIVE_DIR"/fred.*; do
      [[ -e "$dir" || -L "$dir" ]] || continue
      plugin_ids+=("$(basename "$dir")")
    done
  fi

  if [[ -d "$PLUGINS_SRC" ]]; then
    for dir in "$PLUGINS_SRC"/fred.*; do
      [[ -d "$dir" ]] || continue
      local base
      base="$(basename "$dir")"
      if [[ ! " ${plugin_ids[*]:-} " =~ [[:space:]]${base}[[:space:]] ]]; then
        plugin_ids+=("$base")
      fi
    done
  fi

  if [[ "$show_all" -eq 1 ]]; then
    for id in "${!CATALOG_REPOS[@]}"; do
      if [[ ! " ${plugin_ids[*]:-} " =~ [[:space:]]${id}[[:space:]] ]]; then
        plugin_ids+=("$id")
      fi
    done
  fi

  if (( ${#plugin_ids[@]} == 0 )); then
    echo "No fred.* plugins installed. Use 'tam-plugin list --all' or 'search' to discover plugins."
    return 0
  fi

  IFS=$'\n' plugin_ids=($(sort -u <<<"${plugin_ids[*]}"))
  unset IFS

  # Cache omarchy plugin list output
  local plugin_list_json="[]"
  if command -v omarchy-plugin-list >/dev/null 2>&1; then
    plugin_list_json="$(omarchy-plugin-list --json 2>/dev/null || echo "[]")"
  elif command -v omarchy >/dev/null 2>&1; then
    plugin_list_json="$(omarchy plugin list --json 2>/dev/null || echo "[]")"
  fi

  printf "%-18s %-10s %-10s %-22s %s\n" "ID" "INSTALLED" "STATE" "MARKETPLACE" "LATEST GITHUB / LOCAL"

  for id in "${plugin_ids[@]}"; do
    local manifest=""
    if [[ -f "$LIVE_DIR/$id/manifest.json" ]]; then
      manifest="$LIVE_DIR/$id/manifest.json"
    elif [[ -f "$PLUGINS_SRC/$id/manifest.json" ]]; then
      manifest="$PLUGINS_SRC/$id/manifest.json"
    fi

    local version="none"
    if [[ -n "$manifest" ]] && command -v jq >/dev/null 2>&1; then
      version="$(jq -r '.version // "unknown"' "$manifest" 2>/dev/null || echo "unknown")"
    fi

    local state="not installed"
    if [[ -n "$manifest" ]]; then
      state="installed"
      if [[ -n "$plugin_list_json" && "$plugin_list_json" != "[]" ]] && command -v jq >/dev/null 2>&1; then
        local entry
        entry="$(jq -c --arg id "$id" '.[] | select(.id == $id)' <<<"$plugin_list_json" 2>/dev/null || true)"
        if [[ -n "$entry" ]]; then
          local enabled active
          enabled="$(jq -r '.enabled' <<<"$entry")"
          active="$(jq -r '.active' <<<"$entry")"
          if [[ "$active" == "true" ]]; then
            state="active"
          elif [[ "$enabled" == "true" ]]; then
            state="enabled"
          else
            state="disabled"
          fi
        fi
      fi
    fi

    # Check Marketplace Registry status
    local mkt_status="Not Listed"
    [[ -z "${CATALOG_UNPUBLISHED[$id]:-}" ]] || mkt_status="Coming soon"
    if command -v jq >/dev/null 2>&1 && [[ "$registry_json" != "[]" ]]; then
      local mkt_entry
      mkt_entry="$(jq -c --arg id "$id" '.sources[]? | select((.plugins // {}) | has($id))' <<<"$registry_json" 2>/dev/null || true)"
      if [[ -n "$mkt_entry" ]]; then
        local outcome
        outcome="$(jq -r '.automatedSecurityBaseline.outcome // "verified"' <<<"$mkt_entry" 2>/dev/null)"
        if [[ "$outcome" == "passed" || "$outcome" == "verified" ]]; then
          mkt_status="Verified"
        else
          mkt_status="In Review"
        fi
      fi
    fi

    # Check Published Tag / Git remote
    local suffix="${id#fred.}"
    local pub_dir
    pub_dir="$(published_dir "$id")"
    local pub_tag="-"
    if [[ -n "${CATALOG_UNPUBLISHED[$id]:-}" ]]; then
      pub_tag="unpublished"
    elif [[ -d "$pub_dir/.git" ]]; then
      pub_tag="$(git -C "$pub_dir" describe --tags --exact-match 2>/dev/null || git -C "$pub_dir" describe --tags 2>/dev/null || echo "(dev)")"
    elif [[ -n "${CATALOG_REPOS[$id]:-}" ]]; then
      pub_tag="Available"
    fi

    printf "%-18s %-10s %-10s %-22s %s\n" "$id" "$version" "$state" "$mkt_status" "$pub_tag"
  done
}

cmd_info() {
  local id="${1:-}"
  [[ -n "$id" ]] || fail "info requires a plugin id (e.g. fred.clock)"

  local repo_url="${CATALOG_REPOS[$id]:-https://github.com/greenermoose/omarchy-$id.git}"
  local desc="${CATALOG_DESC[$id]:-Personal Omarchy shell plugin}"

  echo "Plugin:      $id"
  echo "Description: $desc"
  echo "Repository:  $repo_url"

  local live_path="$LIVE_DIR/$id"
  if [[ -d "$live_path" || -L "$live_path" ]]; then
    echo "Installed:   Yes ($live_path)"
    if [[ -f "$live_path/manifest.json" ]] && command -v jq >/dev/null 2>&1; then
      local v author
      v="$(jq -r '.version // "unknown"' "$live_path/manifest.json")"
      author="$(jq -r '.author // "Fred"' "$live_path/manifest.json")"
      echo "Version:     $v"
      echo "Author:      $author"
    fi
  else
    echo "Installed:   No"
  fi

  # Query registry
  local registry_json
  registry_json="$(fetch_registry_json)"
  if command -v jq >/dev/null 2>&1 && [[ "$registry_json" != "[]" ]]; then
    local mkt_entry
    mkt_entry="$(jq -c --arg id "$id" '.sources[]? | select((.plugins // {}) | has($id))' <<<"$registry_json" 2>/dev/null || true)"
    if [[ -n "$mkt_entry" ]]; then
      echo "Marketplace: Listed"
      echo "  Added:     $(jq -r '.addedAt // "unknown"' <<<"$mkt_entry")"
      echo "  Commit:    $(jq -r '.listingValidatedCommit // "unknown"' <<<"$mkt_entry")"
      echo "  Security:  $(jq -r '.automatedSecurityBaseline.outcome // "passed"' <<<"$mkt_entry")"
    else
      echo "Marketplace: Not yet listed or review in progress"
    fi
  fi
}

cmd_search() {
  local query="${1:-}"
  printf "%-18s %s\n" "ID" "DESCRIPTION"
  for id in "${!CATALOG_REPOS[@]}"; do
    local desc="${CATALOG_DESC[$id]}"
    if [[ -z "$query" || "$id" =~ $query || "$desc" =~ $query ]]; then
      if [[ -n "${CATALOG_UNPUBLISHED[$id]:-}" ]]; then
        printf "%-18s %s\n" "$id" "$desc [coming soon: not published yet]"
      else
        printf "%-18s %s\n" "$id" "$desc"
      fi
    fi
  done
}

cmd_install() {
  local id="${1:-}"
  local enable_flag=""
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --enable|-e) enable_flag="--enable" ;;
      *) ;;
    esac
    shift
  done

  [[ -n "$id" ]] || fail "install requires a plugin id (e.g. fred.clock)"
  [[ -z "${CATALOG_UNPUBLISHED[$id]:-}" ]] ||
    fail "$id is not published yet (coming soon); there is no public repository to install from"
  local repo_url="${CATALOG_REPOS[$id]:-https://github.com/greenermoose/omarchy-$id.git}"

  if ! command -v omarchy >/dev/null 2>&1; then
    fail "omarchy CLI not found in PATH"
  fi

  echo "Installing $id from $repo_url..."
  if [[ -n "$enable_flag" ]]; then
    omarchy plugin add "$repo_url" --enable
  else
    omarchy plugin add "$repo_url"
  fi
}

cmd_remove() {
  local id="${1:-}"
  [[ -n "$id" ]] || fail "remove requires a plugin id (e.g. fred.clock)"

  if ! command -v omarchy >/dev/null 2>&1; then
    fail "omarchy CLI not found in PATH"
  fi

  echo "Removing $id..."
  omarchy plugin remove "$id"
}

cmd_update() {
  local target="${1:-all}"
  local targets=()

  if [[ "$target" == "all" ]]; then
    if [[ -d "$LIVE_DIR" ]]; then
      for dir in "$LIVE_DIR"/fred.*; do
        [[ -d "$dir" && ! -L "$dir" ]] || continue
        targets+=("$(basename "$dir")")
      done
    fi
  else
    targets+=("$target")
  fi

  if (( ${#targets[@]} == 0 )); then
    echo "No matching installed fred.* plugins to update."
    return 0
  fi

  for id in "${targets[@]}"; do
    local dir="$LIVE_DIR/$id"
    if [[ -d "$dir/.git" ]]; then
      echo "Updating $id..."
      git -C "$dir" pull --ff-only || warn "Failed to update $id via git pull"
    else
      warn "$id is not a git repository in $LIVE_DIR (may be managed via Nix/Home Manager)"
    fi
  done

  reload_shell
}

cmd_diff() {
  local id="${1:-}"
  [[ -n "$id" ]] || fail "diff requires a plugin id (e.g. fred.clock)"
  [[ -d "$REPO_DIR" ]] || fail "diff requires local config repository at $REPO_DIR (set FRED_CONFIG_REPO to customize)"

  local suffix="${id#fred.}"
  local deployed="$PLUGINS_SRC/$id"
  local published
  published="$(published_dir "$id")"

  [[ -d "$deployed" ]] || fail "deployed directory not found: $deployed"
  [[ -d "$published" ]] || fail "published repository not found: $published"

  diff -ur --color=auto \
    --exclude=.git \
    --exclude='*.bak*' \
    --exclude='*~' \
    --exclude='__pycache__' \
    "$deployed" "$published" || true
}

cmd_dev() {
  local id="${1:-}"
  local mode="${2:-}"

  [[ -n "$id" ]] || fail "dev requires a plugin id (e.g. fred.clock)"
  validate_plugin_id "$id"
  [[ "$mode" == "on" || "$mode" == "off" ]] || fail "dev mode must be 'on' or 'off'"
  [[ -d "$REPO_DIR" ]] || fail "dev requires local config repository at $REPO_DIR (set FRED_CONFIG_REPO to customize)"

  local deployed="$PLUGINS_SRC/$id"
  local live="$LIVE_DIR/$id"
  local test_state
  test_state="$(test_state_dir "$id")"
  [[ ! -f "$test_state/active" ]] ||
    fail "$id is in snapshot test mode; run 'tam-plugin test $id off' first"

  if [[ "$mode" == "on" ]]; then
    [[ -d "$deployed" ]] || fail "deployed directory not found: $deployed"
    mkdir -p "$LIVE_DIR"

    if [[ -L "$live" ]] && [[ "$(readlink -f "$live")" == "$(readlink -f "$deployed")" ]]; then
      echo "dev: $id is already linked in dev mode -> $deployed"
      return 0
    fi

    rm -rf "$live"
    ln -s "$deployed" "$live"
    reload_shell
    echo "dev: mode ON for $id -> $deployed"
  else
    # Guards before anything is touched. `dev off` ends in a home-manager
    # switch, and Home Manager resolves every managed file *through* any dev
    # symlink still present: identical files are skipped, but a file that
    # differs from the git tree is replaced in the repo's working tree by a
    # store link (ln -Tsf; HM 26.11 link script). So: no other override may
    # exist, and this plugin must be committed so the generation matches.
    local other others=()
    for other in "$LIVE_DIR"/fred.*; do
      [[ -L "$other" ]] || continue
      [[ "$(basename "$other")" == "$id" ]] && continue
      others+=("$(basename "$other") -> $(readlink "$other")")
    done
    if (( ${#others[@]} > 0 )); then
      printf 'dev: refusing to switch: other plugin overrides are still active:\n' >&2
      printf '  %s\n' "${others[@]}" >&2
      fail "turn them off first, or a home-manager switch could overwrite files in $REPO_DIR"
    fi
    if git -C "$REPO_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      local dirty
      dirty="$(git -C "$REPO_DIR" status --porcelain --untracked-files=all -- "config/omarchy/plugins/$id" 2>/dev/null || true)"
      if [[ -n "$dirty" ]]; then
        printf 'dev: refusing to leave dev mode: uncommitted changes under config/omarchy/plugins/%s:\n%s\n' "$id" "$dirty" >&2
        fail "commit them first; the Home Manager generation is built from the git tree, so untracked files would be left out and the deployed plugin would not match"
      fi
    fi

    if [[ -L "$live" ]]; then
      rm "$live"
      echo "dev: removed dev symlink for $id"
    else
      echo "dev: $live is not a dev symlink"
    fi

    if command -v home-manager >/dev/null 2>&1 && [[ -f "$REPO_DIR/flake.nix" ]]; then
      echo "dev: restoring Home Manager configuration..."
      home-manager switch --flake "${REPO_DIR}#fred"
    else
      echo "dev: note: run home-manager switch or recreate store symlinks if needed."
    fi

    reload_shell
    echo "dev: mode OFF for $id"
  fi
}

case "${1:-}" in
  list)
    shift
    cmd_list "$@"
    ;;
  info)
    shift
    cmd_info "$@"
    ;;
  search)
    shift
    cmd_search "$@"
    ;;
  install)
    shift
    cmd_install "$@"
    ;;
  update)
    shift
    cmd_update "$@"
    ;;
  remove)
    shift
    cmd_remove "$@"
    ;;
  diff)
    shift
    cmd_diff "$@"
    ;;
  dev)
    shift
    cmd_dev "$@"
    ;;
  test)
    shift
    cmd_test "$@"
    ;;
  upstream-diff)
    shift
    cmd_upstream_diff "$@"
    ;;
  -v|--version)
    echo "tam-plugin v${VERSION}"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac
